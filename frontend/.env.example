# Optional until Go is hosted: leave blank to show API-dependent features as unavailable.
# When hosted, set the real public HTTPS Go API base (including /api), then rebuild.
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Explicit local-only booking sandbox. Ignored in production builds.
VITE_BOOKING_DEMO=false
